# =============================================================================
# Astro Analytics Pro - Variables de Entorno
# Copia este archivo como .env (local) o configúralo en Render / Railway / Fly.io
# =============================================================================

# URL pública del proyecto Supabase (Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (Publishable key sb_publishable_... o legacy anon key)
# Segura para enviar al navegador porque todo está protegido por RLS
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Clave secreta del servidor (Secret key sb_secret_... o legacy service_role key)
# NUNCA exponer en frontend ni subir a Git
SUPABASE_SECRET_KEY=sb_secret_xxx

# Secreto compartido para el endpoint POST /api/cron/sync (GitHub Actions / Cron)
# Genera uno fuerte con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-bytes

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Puerto HTTP del servidor (Render/Railway inyectan PORT automáticamente)
PORT=8000
